<Window x:Class="Nori.Desktop.Settings.SettingsWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
        Title="Nori 设置"
        Width="1100"
        Height="760"
        MinWidth="820"
        MinHeight="560">
	<Window.Styles>
		<Style Selector="Window">
			<Setter Property="FontFamily" Value="Microsoft YaHei UI" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
		</Style>
		<Style Selector="TextBlock.page-title">
			<Setter Property="FontSize" Value="20" />
			<Setter Property="FontWeight" Value="Normal" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
		</Style>
		<Style Selector="TextBlock.page-subtitle">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
		</Style>
		<Style Selector="fa|FANavigationView">
			<Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
		</Style>
		<Style Selector=":is(Button).light">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
		</Style>
		<Style Selector=":is(Button).light:pointerover">
			<Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
		</Style>
		<Style Selector=":is(Button).light:pressed">
			<Setter Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
		</Style>
		<Style Selector="Button.accent">
			<Setter Property="Background" Value="{DynamicResource AccentButtonBackground}" />
			<Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource AccentButtonForeground}" />
		</Style>
		<Style Selector="Button.accent:pointerover">
			<Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundPointerOver}" />
			<Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrushPointerOver}" />
			<Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundPointerOver}" />
		</Style>
		<Style Selector="Button.danger">
			<Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
			<Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
		</Style>
		<Style Selector="Button.danger:pointerover">
			<Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
			<Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
		</Style>
		<Style Selector=":is(Button), :is(TextBox), :is(ComboBox), :is(ToggleSwitch), :is(Slider)">
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.1" />
					<BrushTransition Property="BorderBrush" Duration="0:0:0.1" />
					<BrushTransition Property="Foreground" Duration="0:0:0.1" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="StackPanel.settings-container">
			<Setter Property="Margin" Value="12,12,18,12" />
			<Setter Property="MaxWidth" Value="960" />
			<Setter Property="Spacing" Value="4" />
		</Style>
		<Style Selector="ScrollViewer#PageScroll">
			<Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
			<Setter Property="VerticalScrollBarVisibility" Value="Auto" />
		</Style>
	</Window.Styles>
	<Grid x:Name="RootGrid" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
		<Grid RowDefinitions="Auto,*">
			<Border Grid.Row="0" Height="48" Margin="0,0,8,0" Background="Transparent">
				<Grid VerticalAlignment="Center" ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
					<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
						<fa:FASymbolIcon Symbol="Settings" FontSize="18" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
						<TextBlock x:Name="WindowTitle" Text="Nori 设置" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
					</StackPanel>
					<StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
						<TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="12" MaxWidth="280" IsVisible="False" VerticalAlignment="Center" />
						<Button x:Name="CloseButton" Classes="light" Click="CloseButton_OnClick" Padding="8" ToolTip.Tip="关闭设置窗口">
							<fa:FASymbolIcon Symbol="Dismiss" FontSize="16" />
						</Button>
					</StackPanel>
				</Grid>
			</Border>
			<fa:FANavigationView x:Name="NavigationView"
					Grid.Row="1"
					PaneDisplayMode="Auto"
					IsSettingsVisible="False"
					SelectionFollowsFocus="False"
					OpenPaneLength="283"
					ItemInvoked="NavigationView_OnItemInvoked">
				<Grid RowDefinitions="Auto,*">
					<Grid x:Name="PageHeader" Grid.Row="0" Margin="12,16,18,0" MaxWidth="960">
						<StackPanel Spacing="4">
							<TextBlock x:Name="PageTitle" Classes="page-title" />
							<TextBlock x:Name="PageSubtitle" Classes="page-subtitle" TextWrapping="Wrap" />
						</StackPanel>
					</Grid>
					<ScrollViewer x:Name="PageScroll" Grid.Row="1">
						<TransitioningContentControl x:Name="PageContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top" />
					</ScrollViewer>
				</Grid>
			</fa:FANavigationView>
		</Grid>
	</Grid>
</Window>
